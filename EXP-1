from pgmpy.models import DiscreteBayesianNetwork
from pgmpy.factors.discrete import TabularCPD
from pgmpy.inference import VariableElimination

# Create Bayesian Network
model = DiscreteBayesianNetwork([
    ('Amount', 'Fraud'),
    ('Location', 'Fraud'),
    ('Device', 'Fraud')
])

# CPDs
amount = TabularCPD('Amount', 2, [[0.7], [0.3]])
location = TabularCPD('Location', 2, [[0.8], [0.2]])
device = TabularCPD('Device', 2, [[0.75], [0.25]])

fraud = TabularCPD(
    'Fraud', 2,
    [[0.95,0.80,0.70,0.20,0.85,0.60,0.40,0.05],
     [0.05,0.20,0.30,0.80,0.15,0.40,0.60,0.95]],
    evidence=['Amount','Location','Device'],
    evidence_card=[2,2,2]
)

model.add_cpds(amount, location, device, fraud)

# Inference
infer = VariableElimination(model)

result = infer.query(
    ['Fraud'],
    evidence={
        'Amount': 1,
        'Location': 0,
        'Device': 1
    }
)

fraud_prob = result.values[1]
genuine_prob = result.values[0]

print("CREDIT CARD FRAUD DETECTION")
print("---------------------------")
print("Transaction Amount : High")
print("Location           : Normal")
print("Login Device       : Unknown")

print("\nFraud Probability    :", round(fraud_prob, 2))
print("Genuine Probability  :", round(genuine_prob, 2))

if fraud_prob > 0.5:
    print("Risk Level           : HIGH")
    print("Final Prediction     : FRAUDULENT")
else:
    print("Risk Level           : LOW")
    print("Final Prediction     : GENUINE")
