import numpy as np
from hmmlearn import hmm

model = hmm.CategoricalHMM(n_components=3)


model.startprob_ = [0.6, 0.3, 0.1]

model.transmat_ = [
    [0.8, 0.2, 0.0],
    [0.1, 0.7, 0.2],
    [0.0, 0.1, 0.9]
]


model.emissionprob_ = [
    [0.8, 0.2, 0.0],
    [0.2, 0.7, 0.1],
    [0.0, 0.2, 0.8]
]

observations = np.array([
    [0],   # Low
    [1],   # Medium
    [1],   # Medium
    [2],   # High
    [2]    # High
])

_, states = model.decode(observations, algorithm="viterbi")

names = ["Healthy", "Warning", "Failure"]

print("Machine Sensor Analysis")
print("-----------------------")

print("Temperature : 85°C")
print("Vibration   : High")
print("Motor Noise : High")

print("\nPredicted Machine State:", names[states[-1]])
